      "purpose": "maskable any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-dashboard.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "GameFi Dashboard - Desktop View"
    },
    {
      "src": "/screenshots/mobile-games.png",
      "sizes": "375x812",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "GameFi Games - Mobile View"
    }
  ],
  "shortcuts": [
    {
      "name": "Play Games",
      "short_name": "Games",
      "description": "Access coin flip, lottery, and tournament games",
      "url": "/games",
      "icons": [
        {
          "src": "/icons/games-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "NFT Marketplace",
      "short_name": "NFTs",
      "description": "Browse and trade GamePass NFTs",
      "url": "/marketplace",
      "icons": [
        {
          "src": "/icons/nft-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Staking",
      "short_name": "Stake",
      "description": "Stake tokens and earn rewards",
      "url": "/staking",
      "icons": [
        {
          "src": "/icons/stake-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Social Hub",
      "short_name": "Social",
      "description": "Connect with other players and join communities",
      "url": "/social",
      "icons": [
        {
          "src": "/icons/social-96x96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.gamefi.platform",
      "id": "com.gamefi.platform"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/gamefi-platform/id123456789"
    }
  ],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+gamefi",
      "url": "/connect?action=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "screenshot",
          "accept": ["image/png", "image/jpeg", "image/webp"]
        }
      ]
    }
  }
}